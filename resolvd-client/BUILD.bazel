load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build:checks.bzl", "shared_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "tests/**",
            "include/**",
            "build.rs",
        ],
        allow_empty = True,
    ),
)

rust_library(
    name = "resolvd-client",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "Cargo.toml",
        "//:crate-data",
    ],
    crate_name = "resolvd_client",
    crate_root = "src/lib.rs",
    edition = "2024",
    link_deps = ["//libresolvd:link"],
    version = "0.1.6",
    deps = [
        "//resolvd-abi",
        "//resolvd-core",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit-binary",
    size = "small",
    crate = ":resolvd-client",
    tags = ["manual"],
)

shared_test(
    name = "unit",
    size = "small",
    binary = ":unit-binary",
    libraries = [
        "@peios_sdk//:library",
        "//libresolvd:soname",
    ],
)

rust_test(
    name = "shared-binary",
    size = "small",
    srcs = glob(["tests/**/*.rs"]),
    compile_data = ["//:crate-data"],
    crate_root = "tests/shared.rs",
    edition = "2024",
    tags = ["manual"],
    deps = [
        ":resolvd-client",
        "//resolvd-abi",
        "//resolvd-core",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

shared_test(
    name = "shared",
    size = "small",
    binary = ":shared-binary",
    libraries = [
        "@peios_sdk//:library",
        "//libresolvd:soname",
    ],
)

filegroup(
    name = "package-files",
    srcs = glob(
        [
            "**",
            ".github/**",
        ],
        allow_empty = True,
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/target/**",
            "target/**",
            "bazel-*/**",
            "**/.git/**",
            ".ci-sdk/**",
            "**/node_modules/**",
            "**/.venv/**",
            "**/.cache/**",
            "**/.trail-cache/**",
            "docs/learn/dist/**",
            "docs/archive/**",
            "pekit.toml",
            "lint.pekit.toml",
            "packages.pekit/**",
            "packaging/**",
            "out/**",
            "fuzz/corpus/**",
            "fuzz/artifacts/**",
            ".bazel-vendor/**",
            ".build/**",
            "fuzz/logs/**",
            "fuzz/*.log",
        ],
    ),
    visibility = ["//visibility:public"],
)

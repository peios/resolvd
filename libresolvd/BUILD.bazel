load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_test")
load("//build:checks.bzl", "shared_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "tests/**",
            "include/**",
            "build.rs",
        ],
        allow_empty = True,
    ),
)

rust_library(
    name = "libresolvd",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "Cargo.toml",
        "//:crate-data",
    ],
    crate_name = "resolvd_ffi",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.6",
    deps = [
        "//resolvd-abi",
        "//resolvd-core",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit-binary",
    size = "small",
    crate = ":libresolvd",
    tags = ["manual"],
)

shared_test(
    name = "unit",
    size = "small",
    binary = ":unit-binary",
    libraries = [
        "@peios_sdk//:library",
        "//libresolvd:soname",
    ],
)

rust_shared_library(
    name = "shared",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "Cargo.toml",
        "//:crate-data",
    ],
    crate_name = "resolvd_ffi",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = ["-Clink-arg=-Wl,-soname,libresolvd.so.1"],
    version = "0.1.6",
    deps = [
        "//resolvd-abi",
        "//resolvd-core",
    ] + all_crate_deps(normal = True),
)

genrule(
    name = "soname",
    srcs = [":shared"],
    outs = ["libresolvd.so.1"],
    cmd = "cp $(execpath :shared) $@",
)

genrule(
    name = "linker-name",
    srcs = [":shared"],
    outs = ["libresolvd.so"],
    cmd = "cp $(execpath :shared) $@",
)

cc_import(
    name = "binary-link",
    interface_library = ":linker-name",
    shared_library = select({
        "//build:native": None,
        "//build:packaged": None,
        "//conditions:default": ":soname",
    }),
    system_provided = select({
        "//build:native": True,
        "//build:packaged": True,
        "//conditions:default": False,
    }),
)

cc_library(
    name = "link",
    hdrs = glob(
        ["include/**/*.h"],
        allow_empty = True,
    ),
    strip_include_prefix = "include",
    deps = [
        ":binary-link",
        "@peios_sdk//:peios",
    ],
)

filegroup(
    name = "headers",
    srcs = glob(
        ["include/**/*.h"],
        allow_empty = True,
    ),
)

cc_test(
    name = "c-abi-binary",
    size = "small",
    srcs = ["tests/abi.c"],
    copts = ["-UNDEBUG"],
    tags = ["manual"],
    deps = [":link"],
)

shared_test(
    name = "c-abi",
    size = "small",
    binary = ":c-abi-binary",
    libraries = [
        "@peios_sdk//:library",
        "//libresolvd:soname",
    ],
)

filegroup(
    name = "package-files",
    srcs = glob(
        [
            "**",
            ".github/**",
        ],
        allow_empty = True,
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/target/**",
            "target/**",
            "bazel-*/**",
            "**/.git/**",
            ".ci-sdk/**",
            "**/node_modules/**",
            "**/.venv/**",
            "**/.cache/**",
            "**/.trail-cache/**",
            "docs/learn/dist/**",
            "docs/archive/**",
            "pekit.toml",
            "lint.pekit.toml",
            "packages.pekit/**",
            "packaging/**",
            "out/**",
            "fuzz/corpus/**",
            "fuzz/artifacts/**",
            ".bazel-vendor/**",
            ".build/**",
            "fuzz/logs/**",
            "fuzz/*.log",
        ],
    ),
    visibility = ["//visibility:public"],
)

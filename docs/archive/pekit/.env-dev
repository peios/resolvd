# Dev-host env for Cargo in this workspace. Not used by pekit.
RESOLVD_DEV_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
RESOLVD_DEV_PARENT=$(cd "$RESOLVD_DEV_ROOT/.." && pwd -P)
export BINDGEN_EXTRA_CLANG_ARGS="-isystem $(gcc -print-file-name=include)"
export PEIOS_LIB_DIR="$RESOLVD_DEV_PARENT/libpeios/target/debug"
export PEIOS_INCLUDE="$RESOLVD_DEV_PARENT/libpeios/include"
export PKM_UAPI="$RESOLVD_DEV_PARENT/pkm/out/build/headers/usr/include"
export LD_LIBRARY_PATH="$PEIOS_LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
unset RESOLVD_DEV_ROOT RESOLVD_DEV_PARENT

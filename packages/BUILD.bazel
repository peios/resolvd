load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//build:checks.bzl", "host_test")
load(":build.bzl", "resolvd_stage")
load(":names.bzl", "PACKAGE_NAMES")
load(":package.bzl", "package_store_test", "resolvd_package")

exports_files(["family.json"])

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ),
)

rust_binary(
    name = "check-blobs",
    srcs = ["check_blobs.rs"],
    edition = "2024",
    deps = [
        "@ppk_crates//:anyhow",
        "@ppk_crates//:sha2",
        "@ppk_crates//:zstd",
    ],
)

resolvd_stage(
    name = "stage",
    components = {
        "//resolvd:resolvd-bin": "resolvd",
        "//resolv": "resolv",
        "//libresolvd:shared": "libresolvd",
        "//nss:shared": "nss",
    },
    data = ["//:package-data"],
    driver = "stage.py",
    drivers = [
        "stage.py",
        "licences.py",
        "validate.py",
        "family.json",
    ],
    native = select({
        "//build:native": True,
        "//conditions:default": False,
    }),
)

[
    resolvd_package(
        name = name,
        srcs = ["//:package-data"],
        definition = "definitions/" + name + ".json",
        stage = ":stage",
    )
    for name in PACKAGE_NAMES
]

resolvd_package(
    name = "resolvd-source",
    srcs = ["//:package-sources"],
    source = True,
)

filegroup(
    name = "all",
    srcs = [":" + name for name in PACKAGE_NAMES] + [":resolvd-source"],
)

package_store_test(
    name = "store-test",
    size = "small",
    srcs = [
        "assembly.py",
        "package.py",
    ],
    main = "test_store.py",
)

host_test(
    name = "assembly-test",
    size = "small",
    command = "exec python3 packages/test_assembly.py",
    data = [
        "assembly.py",
        "test_assembly.py",
    ],
)

filegroup(
    name = "definitions",
    srcs = glob(["definitions/*.json"]),
)

filegroup(
    name = "build-files",
    srcs = ["BUILD.bazel"] + glob(["*.bzl"]),
)

host_test(
    name = "licences-test",
    size = "small",
    command = "exec python3 packages/test_licences.py",
    data = [
        "licences.py",
        "test_licences.py",
    ],
)

filegroup(
    name = "package-files",
    srcs = glob(
        [
            "**",
            ".github/**",
        ],
        allow_empty = True,
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/target/**",
            "target/**",
            "bazel-*/**",
            "**/.git/**",
            ".ci-sdk/**",
            "**/node_modules/**",
            "**/.venv/**",
            "**/.cache/**",
            "**/.trail-cache/**",
            "docs/learn/dist/**",
            "docs/archive/**",
            "pekit.toml",
            "lint.pekit.toml",
            "packages.pekit/**",
            "packaging/**",
            "out/**",
            "fuzz/corpus/**",
            "fuzz/artifacts/**",
            ".bazel-vendor/**",
            ".build/**",
            "fuzz/logs/**",
            "fuzz/*.log",
        ],
    ),
    visibility = ["//visibility:public"],
)

host_test(
    name = "family-test",
    size = "small",
    command = "exec python3 packages/test_family.py",
    data = [
        "test_family.py",
        "//:packages",
    ],
)
